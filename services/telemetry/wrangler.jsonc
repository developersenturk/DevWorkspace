{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devworkspace-telemetry",
  "account_id": "4ddbc333e6512edc28d49e7aea286e1e",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-19",
  "workers_dev": true,
  "observability": { "enabled": false },
  "ratelimits": [{ "name": "INGEST_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "devworkspace-telemetry",
    "database_id": "1a8bcb31-cf5f-4b1a-bc2a-c5b18e277eea",
    "migrations_dir": "migrations"
  }]
}
