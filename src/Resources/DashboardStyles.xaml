<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core">
    <Style x:Key="DashboardSurface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Canvas}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style x:Key="DashboardSectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="DashboardSecondary" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="DashboardColumnHeader" TargetType="TextBlock" BasedOn="{StaticResource DashboardSecondary}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <Style x:Key="DashboardMetricButton" TargetType="dx:SimpleButton">
        <Setter Property="Background" Value="{DynamicResource Canvas}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Divider}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="11,8"/>
        <Setter Property="Margin" Value="0,0,7,6"/>
        <Setter Property="MinHeight" Value="58"/>
    </Style>
    <Style x:Key="DashboardRowButton" TargetType="dx:SimpleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="34"/>
    </Style>
    <Style x:Key="DashboardAction" TargetType="dx:SimpleButton">
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="MinHeight" Value="28"/>
    </Style>
    <Style x:Key="DashboardSeverity" TargetType="Border">
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Padding" Value="7,3"/>
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralSurface}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralText}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Kritik">
                <Setter Property="Background" Value="{DynamicResource BadgeErrorText}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorSurface}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Yüksek">
                <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Orta">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Düşük">
                <Setter Property="Background" Value="{DynamicResource BadgeAccentSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeAccentText}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
