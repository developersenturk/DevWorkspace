<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="SmallLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>

    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="7,4"/>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,4"/>

    </Style>
    <Style x:Key="SoftCheck" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="NavRow" TargetType="dxe:ListBoxEditItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="NavigationCountBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BadgeAccentSurface}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeAccentText}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinWidth" Value="22"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Margin" Value="5,0,0,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Key}" Value="changed">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Key}" Value="warning">
                <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Count}" Value="0">
                <Setter Property="Background" Value="{DynamicResource BadgeNeutralSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsSection}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="NavigationCountLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="8,2"/>
        <Setter Property="Background" Value="{DynamicResource BadgeNeutralSurface}"/>
        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralText}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Git.State}" Value="Clean">
                <Setter Property="Background" Value="{DynamicResource BadgeSuccessSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Git.State}" Value="Changed">
                <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Git.State}" Value="Ownership">
                <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding Git.State}" Value="Unavailable">
                <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="StatusLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
</ResourceDictionary>

