<Window x:Class="DevWorkspace.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DevWorkspace hazırlanıyor" Icon="../Assets/DevWorkspace.ico"
        Width="368" SizeToContent="Height" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource Shell}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Border BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="24,22">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Image Source="../Assets/DevWorkspace.ico" Width="40" Height="40" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="DevWorkspace" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Uygulama hazırlanıyor…" FontSize="13" Margin="0,3,0,0"
                               Foreground="{DynamicResource Muted}"/>
                </StackPanel>
            </Grid>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,18,0,0"
                         AutomationProperties.Name="Uygulama hazırlanıyor"/>
        </StackPanel>
    </Border>
</Window>
