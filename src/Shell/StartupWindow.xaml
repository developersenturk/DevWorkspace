<Window x:Class="DevWorkspace.StartupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L1A3196F8972E}" Icon="../Assets/DevWorkspace.ico"
        Width="600" Height="372" WindowStyle="None" ResizeMode="NoResize"
        AllowsTransparency="True" PreviewKeyDown="WindowKeyDown"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="Transparent" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Assets/BrandMark.xaml"/></ResourceDictionary.MergedDictionaries>
        <Style x:Key="StageNumber" TargetType="Border">
            <Setter Property="Width" Value="26"/><Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="StageLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/><Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="9,0,0,0"/>
        </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Border Background="{DynamicResource Shell}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition/><RowDefinition Height="68"/></Grid.RowDefinitions>
            <Border Grid.RowSpan="2" CornerRadius="16,16,0,0" IsHitTestVisible="False">
                <Border.Background>
                    <RadialGradientBrush Center="0.95,0.05" GradientOrigin="0.95,0.05" RadiusX="0.9" RadiusY="1.2">
                        <GradientStop Color="#258469E8" Offset="0"/><GradientStop Color="#088469E8" Offset="0.6"/><GradientStop Color="#008469E8" Offset="1"/>
                    </RadialGradientBrush>
                </Border.Background>
            </Border>
            <Grid Margin="28,12,16,0" MouseLeftButtonDown="HeaderMouseDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="6" Height="6" CornerRadius="3" Background="#8A6BE8" Margin="0,0,9,0"/>
                    <TextBlock Text="DEVELOPER WORKBENCH" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="30" Height="30" MinHeight="0" Padding="0"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                        Foreground="{DynamicResource Muted}" Click="CloseClick" ToolTip="{DynamicResource StartupClose}" AutomationProperties.Name="{DynamicResource StartupClose}"/>
            </Grid>
            <Grid Grid.Row="1" Margin="32,13,32,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Image Source="{StaticResource DevWorkspaceMark}" Width="78" Height="78" Margin="0,0,20,0"
                           AutomationProperties.Name="DevWorkspace"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="DevWorkspace" FontSize="34" FontWeight="SemiBold"/>
                        <TextBlock Text="{DynamicResource StartupTagline}" FontSize="14" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="1,4,0,0"/>
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,28,0,0">
                    <TextBlock x:Name="StatusLabel" Text="{DynamicResource StartupPreparing}" FontSize="14" FontWeight="Medium" AutomationProperties.LiveSetting="Polite"/>
                    <ProgressBar x:Name="LoadingProgress" IsIndeterminate="True" Height="3" MinHeight="0" MaxHeight="3" Margin="0,13,0,0" BorderThickness="0"
                                 Background="{DynamicResource Line}" Foreground="#8A6BE8" AutomationProperties.Name="{DynamicResource LB2B09681094C}">
                        <ProgressBar.Template>
                            <ControlTemplate TargetType="ProgressBar">
                                <Grid ClipToBounds="True">
                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="1.5"/>
                                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="1.5"/>
                                    <Border x:Name="Pulse" Width="128" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="1.5" Visibility="Collapsed">
                                        <Border.RenderTransform><TranslateTransform X="-128"/></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsIndeterminate" Value="True">
                                        <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="Pulse" Property="Visibility" Value="Visible"/>
                                        <Trigger.EnterActions>
                                            <BeginStoryboard x:Name="LoadingSweep">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetName="Pulse" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                     From="-128" To="600" Duration="0:0:1.8"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions><RemoveStoryboard BeginStoryboardName="LoadingSweep"/></Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ProgressBar.Template>
                    </ProgressBar>
                </StackPanel>
                <Grid Grid.Row="2" Margin="0,19,0,15">
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <StackPanel x:Name="InterfaceStage" Orientation="Horizontal">
                        <Border x:Name="InterfaceNumber" Style="{StaticResource StageNumber}"><TextBlock Text="01" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{DynamicResource StartupInterface}" Style="{StaticResource StageLabel}"/>
                    </StackPanel>
                    <StackPanel x:Name="ProjectsStage" Grid.Column="1" Orientation="Horizontal" Opacity="0.5">
                        <Border x:Name="ProjectsNumber" Style="{StaticResource StageNumber}"><TextBlock Text="02" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{DynamicResource StartupProjects}" Style="{StaticResource StageLabel}"/>
                    </StackPanel>
                    <StackPanel x:Name="WorkspaceStage" Grid.Column="2" Orientation="Horizontal" Opacity="0.5">
                        <Border x:Name="WorkspaceNumber" Style="{StaticResource StageNumber}"><TextBlock Text="03" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <TextBlock Text="{DynamicResource StartupWorkspace}" Style="{StaticResource StageLabel}"/>
                    </StackPanel>
                </Grid>
            </Grid>
            <Border Grid.Row="2" Background="{DynamicResource SurfaceRaised}" CornerRadius="0,0,16,16" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="WINDOWS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="VersionLabel" FontSize="11" Foreground="{DynamicResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource StartupLocal}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
