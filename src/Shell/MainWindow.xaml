<Window x:Class="DevWorkspace.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        xmlns:dxdo="http://schemas.devexpress.com/winfx/2008/xaml/docking"
        xmlns:local="clr-namespace:DevWorkspace"
        xmlns:dxmvvm="http://schemas.devexpress.com/winfx/2008/xaml/mvvm"
        xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" Title="DevWorkspace"
        Icon="../Assets/DevWorkspace.ico" Width="1240" Height="700" MinWidth="800" MinHeight="480" WindowStartupLocation="CenterScreen"
        Loaded="OnLoaded" Closing="OnClosing" Closed="OnClosed" PreviewKeyDown="WindowKeyDown"
        AllowDrop="True" PreviewDragOver="ProjectDragOver" PreviewDrop="ProjectDrop"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Workbench.xaml"/>
                <ResourceDictionary Source="../Resources/DashboardStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="AppUpdateToastTemplate"><local:AppUpdateToast/></DataTemplate>
            <Style x:Key="AppUpdateToastHost" TargetType="ContentControl">
                <Setter Property="Width" Value="380"/>
                <Setter Property="Height" Value="160"/>
                <Setter Property="MinHeight" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ContentControl">
                            <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <local:ProjectGroupMembershipConverter x:Key="ProjectGroupMembership"/>
            <DataTemplate x:Key="DashboardLink">
                <dx:SimpleButton Click="DashboardLinkClick" Style="{StaticResource DashboardRowButton}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE72A;" Style="{StaticResource Icon}"
                                   Foreground="{DynamicResource Muted}" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="11"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                        </StackPanel>
                    </DockPanel>
                </dx:SimpleButton>
            </DataTemplate>
            <DataTemplate x:Key="DashboardTaskLink">
                <Border CornerRadius="6" Margin="0,4,0,0" BorderThickness="3,0,0,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUrgent}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BadgeWarningText}"/>
                                    <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DashboardLink}"
                                    HorizontalContentAlignment="Stretch"/>
                </Border>
            </DataTemplate>
            <Style x:Key="DashboardCheckRows" TargetType="ListBox">
                <Setter Property="ItemTemplate" Value="{StaticResource DashboardLink}"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="MaxHeight" Value="240"/>
                <Setter Property="Margin" Value="0,6,0,0"/>
                <Style.Triggers>
                    <Trigger Property="HasItems" Value="False"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
                </Style.Triggers>
            </Style>
            <DataTemplate x:Key="DashboardMetric">
                <dx:SimpleButton Click="DashboardLinkClick" Style="{StaticResource DashboardMetricButton}" ToolTip="{Binding Title}">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource DashboardColumnHeader}"/>
                        <TextBlock Text="{Binding Detail}" FontSize="23" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Navigation}" Value="changed">
                                            <Setter Property="Foreground" Value="{DynamicResource BadgeWarningText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Navigation}" Value="warning">
                                            <Setter Property="Foreground" Value="{DynamicResource BadgeErrorText}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Detail}" Value="0">
                                            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </dx:SimpleButton>
            </DataTemplate>
            <DataTemplate x:Key="DashboardSeverityMetric">
                <dx:SimpleButton Style="{StaticResource DashboardMetricButton}"
                                 AutomationProperties.Name="{Binding SeverityLabel}" ToolTip="{Binding SeverityLabel}">
                    <StackPanel>
                        <Border Style="{StaticResource DashboardSeverity}">
                            <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding Count}" FontSize="19" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                </dx:SimpleButton>
            </DataTemplate>
            <DataTemplate x:Key="DashboardFindingRow">
                <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0">
                    <dx:SimpleButton Style="{StaticResource DashboardRowButton}"
                                     AutomationProperties.Name="{Binding Package}" ToolTip="{Binding Detail}"
                                     Click="DashboardFindingClick" ContextMenuOpening="FindingContextOpening">
                        <dx:SimpleButton.ContextMenu><ContextMenu/></dx:SimpleButton.ContextMenu>
                        <Grid Margin="4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/><ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="68"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource DashboardSeverity}">
                                <TextBlock Text="{Binding SeverityLabel}" FontSize="10" FontWeight="SemiBold"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Package}" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding Version}" FontFamily="Consolas"
                                       FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Grid.Column="3" Text="{Binding Target}" Foreground="{DynamicResource Muted}"
                                       FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        </Grid>
                    </dx:SimpleButton>
                </Border>
            </DataTemplate>
            <Style x:Key="MainMenuItem" TargetType="MenuItem">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=MenuItem}}"
                                           Style="{StaticResource Icon}" FontSize="12" Margin="0,0,5,0"/>
                                <AccessText Text="{Binding}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ExplorerActionButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="24"/><Setter Property="Height" Value="23"/>
                <Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="0"/>
                <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            </Style>
            <DataTemplate x:Key="ExplorerNodeLabel">
                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSection}" Value="True">
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DataTemplate>
            <DataTemplate x:Key="ExplorerNodeEditor">
                <dxe:TextEdit x:Name="InlineFolderName" EditValue="{Binding FolderEdit.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              Loaded="ExplorerInlineEditorLoaded"
                              Height="23" Margin="0,1" Padding="4,0" VerticalContentAlignment="Center"
                              AutomationProperties.Name="{DynamicResource L505B9693A658}" ToolTip="{DynamicResource LD6D340899CDA}"/>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>
    <dxmvvm:Interaction.Behaviors>
        <dxmvvm:NotificationService x:Name="AppUpdateNotifications"
            CustomNotificationTemplate="{StaticResource AppUpdateToastTemplate}"
            CustomNotificationStyle="{StaticResource AppUpdateToastHost}"
            CustomNotificationPosition="BottomRight" CustomNotificationScreen="ApplicationWindow"
            CustomNotificationVisibleMaxCount="1" UseWin8NotificationsIfAvailable="False"/>
    </dxmvvm:Interaction.Behaviors>
    <Grid Background="{DynamicResource WorkspaceBackground}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>

        <Grid Margin="8,3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <dx:SimpleButton x:Name="WhatsNewButton" Grid.Column="2" Click="WhatsNewClick" Padding="10,5" Margin="12,0,0,0"
                             AutomationProperties.Name="{DynamicResource UpdateWhatsNew}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{DynamicResource UpdateWhatsNew}" VerticalAlignment="Center"/>
                    <Border x:Name="NewsBadge" Background="{DynamicResource BadgeAccentSurface}" CornerRadius="4" Padding="5,1" Margin="7,0,0,0">
                        <TextBlock Text="{DynamicResource UpdateNotesNew}" Foreground="{DynamicResource BadgeAccentText}" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </dx:SimpleButton>
            <DockPanel Grid.Column="1" MaxWidth="350" Height="28" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0,0,0">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{DynamicResource Muted}" Margin="0,0,8,0"/>
                <Button DockPanel.Dock="Right" x:Name="ClearSearchButton" Content="×" FontSize="17" Width="25" MinHeight="23"
                        Style="{StaticResource IconButton}" Padding="2,0" Visibility="Collapsed"
                        Click="ClearSearchClick" AutomationProperties.Name="{DynamicResource L5A3F99C5C09D}"/>
                <dxe:TextEdit x:Name="SearchBox" EditValueChanged="FilterChanged" Padding="7,0"
                              NullText="{DynamicResource L5B0092AE80FA}" NullTextForeground="{DynamicResource Muted}"
                              ShowNullTextForEmptyValue="True" ShowNullTextIfFocused="False"
                              VerticalContentAlignment="Center" AutomationProperties.Name="{DynamicResource L5B0092AE80FA}"/>
            </DockPanel>
            <Menu x:Name="MainMenu" VerticalAlignment="Center">
                <MenuItem x:Name="FileMenu" Header="{DynamicResource L92BB285EE747}" Tag="&#xE8A5;" Style="{StaticResource MainMenuItem}" SubmenuOpened="FileMenuOpened">
                    <MenuItem Icon="{local:MenuGlyph &#xE838;}" x:Name="OpenWorkspaceMenu" Header="{DynamicResource LF06442277791}" InputGestureText="Ctrl+O" Click="ChooseWorkspaceClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE81C;}" x:Name="RecentWorkspacesMenu" Header="{DynamicResource L36D5DC620F15}"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE721;}" x:Name="QuickOpenMenu" Header="{DynamicResource L04FB6F21D6EE}" InputGestureText="Ctrl+K" Click="QuickOpenClick" IsEnabled="False"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE81C;}" Header="{DynamicResource LEFF4F43841EA}" Click="ResumeWorkspaceClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE768;}" x:Name="LaunchProfilesMenu" Header="{DynamicResource LC12C038CF0C7}"
                              SubmenuOpened="LaunchProfilesMenuOpened">
                        <MenuItem Header="{DynamicResource L278308576E73}" Click="LaunchProfilesClick"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE71B;}" x:Name="LinkSolutionMenu" Header="{DynamicResource LD42E6DDCBB2B}" Click="LinkSolutionClick" IsEnabled="False"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE71B;}" x:Name="LinkFolderMenu" Header="{DynamicResource L8B43A81027D6}" Click="LinkFolderClick" IsEnabled="False"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE74E;}" x:Name="ExportWorkspaceMenu" Header="{DynamicResource LFEFE09C46493}" Click="ExportWorkspaceClick" IsEnabled="False"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE896;}" x:Name="ImportWorkspaceMenu" Header="{DynamicResource LE9A1DCFC8134}" Click="ImportWorkspaceClick"/>
                    <MenuItem x:Name="ReportWorkspaceMenu" Header="{DynamicResource ReportExport}" Click="ReportWorkspaceClick" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE8BB;}" Header="{DynamicResource L246E2D6478ED}" InputGestureText="Alt+F4" Click="ExitClick"/>
                </MenuItem>
                <MenuItem x:Name="ProjectMenu" Header="{DynamicResource L1B4E10468B2F}" Tag="&#xE8B7;" Style="{StaticResource MainMenuItem}" SubmenuOpened="ProjectMenuOpened">
                    <MenuItem Header="{DynamicResource L8B7727A043AF}" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="Gi_t" Tag="&#xE8F1;" Style="{StaticResource MainMenuItem}" SubmenuOpened="GitMenuOpened">
                    <MenuItem Icon="{local:MenuGlyph &#xE8F1;}" x:Name="SelectedRepositoryMenu" Header="{DynamicResource LC9FB4EFC0339}" IsEnabled="False">
                        <MenuItem Icon="{local:MenuGlyph {x:Static local:MenuGlyphExtension.GitHistory}}" Header="{DynamicResource L8C9C5A963356}" Tag="History" Click="RepositoryCommandClick"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE8F1;}" Header="{DynamicResource L89245D66A841}" Tag="References" Click="RepositoryCommandClick"/>
                        <Separator/>
                        <MenuItem Icon="{local:MenuGlyph &#xE896;}" Header="{DynamicResource L5434B2AD0F2B}" Tag="Fetch" Click="RepositoryCommandClick"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE72C;}" Header="{DynamicResource LC918B0018CBE}" Tag="Pull" Click="RepositoryCommandClick"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE898;}" Header="{DynamicResource LE78BFEC2460E}" Tag="Push" Click="RepositoryCommandClick"/>
                    </MenuItem>
                    <MenuItem x:Name="BatchFetchMenu" Icon="{local:MenuGlyph &#xE896;}" Header="{DynamicResource L813B585D130E}" Click="BatchFetchClick"
                              ToolTip="{DynamicResource L86A8EF62528F}" IsEnabled="False"/>
                    <MenuItem x:Name="GitHubRepositoriesMenu" Icon="{local:MenuGlyph &#xE753;}" Header="{DynamicResource LAEC38F63E121}" Click="GitHubRepositoriesClick"/>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE890;}" x:Name="GitNavigationMenu" Header="{DynamicResource LEEC38A6A1F6F}" IsEnabled="False">
                        <MenuItem Icon="{local:MenuGlyph &#xE8F1;}" Header="{DynamicResource LBBF8DEC3700C}" Tag="repositories" Click="NavigateFromMenu"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE70F;}" Header="{DynamicResource L015C1B0968C6}" Tag="changed" Click="NavigateFromMenu"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE7BA;}" Header="{DynamicResource L087EEE8F2B23}" Tag="warning" Click="NavigateFromMenu"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE777;}" x:Name="GitRecoveryMenu" Header="{DynamicResource L79E8482A15E2}" Click="GitRecoveryClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE8B7;}" x:Name="GitRecoveryFolderMenu" Header="{DynamicResource LB2048E60C6DA}" Click="GitRecoveryFolderClick"
                              ToolTip="{DynamicResource L8BF07350D320}"/>
                </MenuItem>
                <MenuItem x:Name="ViewMenu" Header="{DynamicResource L29F0FFA0D755}" Tag="&#xE890;" Style="{StaticResource MainMenuItem}" SubmenuOpened="ViewMenuOpened">
                    <MenuItem Header="{DynamicResource WorkbenchTools}" Click="WorkspaceToolsClick"/>
                    <MenuItem Header="{DynamicResource WorkbenchSearch}" InputGestureText="Ctrl+Shift+F" Tag="0" Click="WorkspaceToolsClick"/>
                    <MenuItem Header="{DynamicResource WorkbenchGitSummary}" Tag="1" Click="WorkspaceToolsClick"/>
                    <MenuItem Header="{DynamicResource WorkbenchRuntime}" Tag="2" Click="WorkspaceToolsClick"/>
                    <MenuItem Header="{DynamicResource WorkbenchDependencies}" Tag="3" Click="WorkspaceToolsClick"/>
                    <MenuItem Header="{DynamicResource WorkbenchTemplates}" Tag="4" Click="WorkspaceToolsClick"/>
                    <MenuItem Header="{DynamicResource WorkbenchEnvironment}" Tag="5" Click="WorkspaceToolsClick"/>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE72C;}" x:Name="RefreshMenu" Header="{DynamicResource L9AC0650A83BE}" InputGestureText="F5" Click="RefreshClick" IsEnabled="False"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE721;}" Header="Projelerde ara" InputGestureText="Ctrl+F" Click="FocusSearchClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE890;}" Header="{DynamicResource LB6A23FF8FBA9}">
                        <MenuItem Icon="{local:MenuGlyph &#xE80A;}" Header="{DynamicResource L699B4A551D76}" Tag="overview" Click="NavigateFromMenu"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE80A;}" Header="{DynamicResource L1191AFF270DA}" Tag="all" Click="NavigateFromMenu"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE734;}" Header="{DynamicResource L13E9F8C058C9}" Tag="favorites" Click="NavigateFromMenu"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE81C;}" Header="{DynamicResource LA46393ADBAA2}" Tag="recent" Click="NavigateFromMenu"/>
                    </MenuItem>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE8FD;}" Header="{DynamicResource L073161304EB1}">
                        <MenuItem Icon="{local:MenuGlyph &#xE8CB;}" x:Name="CompactMenu" Header="{DynamicResource LE7CC39B47178}" IsCheckable="True" Click="CompactDensityClick"/>
                        <MenuItem Icon="{local:MenuGlyph &#xE8CE;}" x:Name="ComfortableMenu" Header="{DynamicResource LA131B63C0FA9}" IsCheckable="True" Click="ComfortableDensityClick"/>
                    </MenuItem>
                    <MenuItem Icon="{local:MenuGlyph &#xE790;}" x:Name="ThemeMenu" Header="{DynamicResource LD5DF3708BC68}"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE8A9;}" x:Name="ColumnsMenu" Header="{DynamicResource L986FCE6A1BD1}"/>
                    <Separator/>
                    <MenuItem x:Name="SaveFilterMenu" Icon="{local:MenuGlyph &#xE74E;}" Header="{DynamicResource L864D3C82E15A}" Click="SaveFilterClick"/>
                    <MenuItem x:Name="RemoveFilterMenu" Icon="{local:MenuGlyph &#xE74D;}" Header="{DynamicResource LD8B6F509B175}" Click="RemoveFilterClick" IsEnabled="False"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource SettingsTitle}" Tag="&#xE713;" Style="{StaticResource MainMenuItem}" Click="SettingsClick"/>
                <MenuItem x:Name="WindowsMenu" Header="{DynamicResource WindowsMenuTitle}" Tag="&#xE78B;" Style="{StaticResource MainMenuItem}" SubmenuOpened="WindowsMenuOpened">
                    <MenuItem Icon="{local:MenuGlyph &#xE9D9;}" Header="{DynamicResource L4328F6541368}" Click="OperationCenterClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE7BA;}" Header="Takip edilen bulgular…" Click="TrackedFindingsClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE8B7;}" Header="{DynamicResource L768201CBF793}" Click="ShowExplorerClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE80A;}" Header="{DynamicResource L10A304DEBE0F}" Click="ShowProjectListClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE946;}" x:Name="ShowProjectInfoMenu" Header="{DynamicResource L4C26507A1012}" Click="ShowProjectInfoClick" IsEnabled="False"/>
                    <MenuItem Icon="{local:MenuGlyph {x:Static local:MenuGlyphExtension.GitOperations}}" x:Name="ShowGitMenu" Header="{DynamicResource LD11171088FD5}" Click="ShowGitClick" IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE74E;}" Header="{DynamicResource LEA0988BECDBE}" Click="SaveNamedLayoutClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE78B;}" x:Name="SavedLayoutsMenu" Header="{DynamicResource L8B64575B0158}"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE777;}" x:Name="ResetLayoutMenu" Header="{DynamicResource L263E1655C155}" Click="ResetDockLayoutClick"/>
                </MenuItem>
                <MenuItem Header="{DynamicResource LC34984AA1A10}" Tag="&#xE897;" Style="{StaticResource MainMenuItem}">
                    <MenuItem Header="{DynamicResource WelcomeMenu}" Click="WelcomeClick"/>
                    <MenuItem Header="{DynamicResource BugReport}" Click="BugReportClick"/>
                    <MenuItem Header="{DynamicResource UsageTitle}" Click="UsageClick"/>
                    <Separator/>
                    <MenuItem Header="{DynamicResource UpdateWhatsNew}" Click="WhatsNewClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE895;}" Header="{DynamicResource UpdateCheck}" Click="CheckAppUpdatesClick"/>
                    <MenuItem x:Name="RestartAppUpdateMenu" Header="{DynamicResource UpdateRestart}" Click="RestartForAppUpdateClick" Visibility="Collapsed"/>
                    <MenuItem Header="{DynamicResource LF69B046E069D}" Click="DevelopmentToolsClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE765;}" Header="{DynamicResource LDAE232AB03CD}" Click="KeyboardShortcutsClick"/>
                    <MenuItem Icon="{local:MenuGlyph &#xE713;}" Header="{DynamicResource L1D400DEC5BFB}" Click="SettingsLocationsClick"/>
                    <Separator/>
                    <MenuItem Icon="{local:MenuGlyph &#xE946;}" Header="{DynamicResource LDBC6A81F6489}" Click="AboutClick"/>
                </MenuItem>
            </Menu>
        </Grid>

        <dxdo:DockLayoutManager x:Name="WorkbenchDock" Grid.Row="1" Margin="10,0,10,0"
                                DockingStyle="VS2010" ClosedPanelsBarVisibility="Never"
                                DockItemClosed="WorkbenchPaneClosed">
            <dxdo:LayoutGroup x:Name="WorkbenchRoot" Orientation="Horizontal" DockItemInterval="6">
                <dxdo:LayoutPanel x:Name="ExplorerPane" Caption="{DynamicResource L768201CBF793}" ItemWidth="207" MinWidth="155" MaxWidth="400"
                                  AllowClose="False" ShowCloseButton="False">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,7,10,7">
                        <TextBlock x:Name="WorkspacePath" Text="{DynamicResource LEB28C758D53B}" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </DockPanel>
                    <dxg:TreeViewControl x:Name="Navigation" Background="{DynamicResource PanelSoft}"
                        DataAreaBackground="{DynamicResource PanelSoft}" BorderThickness="0"
                        TreeViewFieldName="Label" ChildNodesPath="Children" HasChildNodesPath="HasChildren"
                        ExpandStateFieldName="Expanded" EnableDynamicLoading="True" FetchSublevelChildrenOnExpand="False"
                        ShowRootIndent="False" NodeIndent="13" AllowEditing="False" HorizontalScrollbarVisibility="Disabled"
                        SelectedItemChanged="NavigationChanged" NodeExpanded="FolderExpanded" NodeCollapsed="FolderCollapsed"
                        PreviewKeyDown="ExplorerNavigationKeyDown" AutomationProperties.Name="{DynamicResource LA4716712B780}">
                        <dxg:TreeViewControl.NodeContentTemplate>
                            <DataTemplate>
                                <DockPanel x:Name="FolderRow" DataContext="{Binding RowData.Row}" ToolTip="{Binding Hint}"
                                           Background="Transparent" Margin="1,0,6,0" MinHeight="26"
                                           PreviewMouseRightButtonDown="ExplorerFolderRightClick">
                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Icon}" Style="{StaticResource Icon}" Margin="0,0,6,0"/>
                                    <StackPanel x:Name="FolderActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                                        <Button Content="+" Style="{StaticResource ExplorerActionButton}" Click="AddExplorerFolderClick"
                                                AutomationProperties.Name="{DynamicResource L8D62DD79B534}" ToolTip="{DynamicResource L286495C516C9}"/>
                                        <Button Content="⋯" Style="{StaticResource ExplorerActionButton}" Click="ExplorerFolderMenuClick"
                                                AutomationProperties.Name="{DynamicResource L9ECF8143E086}" ToolTip="{DynamicResource L9ECF8143E086}"/>
                                    </StackPanel>
                                    <Border x:Name="FolderCount" DockPanel.Dock="Right" Style="{StaticResource NavigationCountBadge}">
                                        <TextBlock Text="{Binding Count}" Style="{StaticResource NavigationCountLabel}"/>
                                    </Border>
                                    <ContentControl Content="{Binding}" IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ContentTemplate" Value="{StaticResource ExplorerNodeLabel}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                        <Setter Property="ContentTemplate" Value="{StaticResource ExplorerNodeEditor}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DockPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.Count, ElementName=FolderRow}" Value="{x:Null}">
                                        <Setter TargetName="FolderCount" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsEditing, ElementName=FolderRow}" Value="True">
                                        <Setter TargetName="FolderCount" Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.HasFolderActions, ElementName=FolderRow}" Value="True"/>
                                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=dxg:RowControl}}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="FolderActions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="FolderCount" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding DataContext.HasFolderActions, ElementName=FolderRow}" Value="True"/>
                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=FolderRow}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="FolderActions" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="FolderCount" Property="Visibility" Value="Collapsed"/>
                                    </MultiDataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
