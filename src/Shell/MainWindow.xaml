                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </Style>
                                <Style x:Key="DrawerAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Padding" Value="8,3"/>
                                    <Setter Property="MinHeight" Value="28"/>
                                    <Setter Property="Margin" Value="0,0,5,4"/>
                                </Style>
                                <Style x:Key="DrawerPrimary" TargetType="Button" BasedOn="{StaticResource DrawerAction}">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Background" Value="{DynamicResource BadgeAccentSurface}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource BadgeAccentText}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                </Style>
                            </Border.Resources>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="13,13,13,5">
                                    <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,5,0,9">
                                        <Border Style="{StaticResource StatusBadge}" Margin="0,0,7,3">
                                            <TextBlock Text="{Binding Git.Label}" Style="{StaticResource StatusLabel}"/>
                                        </Border>
                                        <TextBlock x:Name="DrawerBranch" Text="{Binding Git.Branch}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,0,0,3"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,0,0,8">
                                        <Button x:Name="DrawerOpenButton" Content="{DynamicResource L439CC142CAA2}" Click="DrawerOpenProjectClick"
                                                Style="{StaticResource DrawerPrimary}"/>
                                        <Button x:Name="DrawerOpenFolderButton" Content="{DynamicResource LD6F2F6CAD078}" Click="DrawerOpenFolderClick"/>
                                        <Button x:Name="DrawerGitButton" Content="{DynamicResource LD11171088FD5}" Click="DrawerGitClick"
                                                Style="{StaticResource DrawerAction}"/>
                                        <Button x:Name="DrawerGitInitButton" Content="{DynamicResource L55506B22BDCE}" Click="DrawerGitInitClick"
                                                Style="{StaticResource DrawerAction}"/>
                                    </WrapPanel>
                                    <Border x:Name="DrawerNuGetCard" Style="{StaticResource DrawerCard}" Visibility="Collapsed">
                                        <Border.Resources>
                                            <Style x:Key="NuGetCaption" TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                                <Setter Property="TextWrapping" Value="Wrap"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="Margin" Value="0,4,0,0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="Text" Value="">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Resources>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L4E3928A63F29}" Style="{StaticResource DrawerHeading}"/>
                                            <Border HorizontalAlignment="Left" CornerRadius="6" Padding="7,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BadgeNeutralSurface}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Success">
                                                                <Setter Property="Background" Value="{DynamicResource BadgeSuccessSurface}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningText}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tone}" Value="Error">
                                                                <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                                                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11" TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding Breakdown}" Style="{StaticResource NuGetCaption}"/>
                                            <TextBlock Text="{Binding LastScan}" Style="{StaticResource NuGetCaption}"/>
                                            <TextBlock Text="{Binding Notice}" ToolTip="{Binding Details}" Style="{StaticResource NuGetCaption}"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button x:Name="DrawerNuGetScanButton" Content="{DynamicResource LEA4A12995D9E}" Click="DrawerNuGetScanClick"
                                                        Style="{StaticResource DrawerAction}" IsEnabled="{Binding CanScan, FallbackValue=False}"/>
                                                <Button x:Name="DrawerNuGetButton" Content="{DynamicResource L70AAB7B9B7E3}" Tag="NuGet" Click="DrawerToolClick"
                                                        Style="{StaticResource DrawerAction}" AutomationProperties.Name="{DynamicResource L82DC224C2268}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DrawerToolsCard" Style="{StaticResource DrawerCard}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L479FD445EFC6}" Style="{StaticResource DrawerHeading}"/>
                                            <WrapPanel>
                                                <Button x:Name="DrawerCommandsButton" Content="{DynamicResource LD2852C907C2D}" Style="{StaticResource DrawerAction}"
                                                        Tag="Commands" Click="DrawerToolClick"/>
                                                <Button x:Name="DrawerActionsButton" Content="GitHub Actions" Style="{StaticResource DrawerAction}"
                                                        Tag="Actions" Click="DrawerToolClick"/>
                                                <Button x:Name="DrawerComposeButton" Content="Docker Compose" Style="{StaticResource DrawerAction}"
                                                        Tag="Compose" Click="DrawerToolClick"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DrawerCard}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource WorkbenchResumeNote}" Style="{StaticResource DrawerHeading}"/>
                                            <TextBlock x:Name="DrawerResumeText" TextWrapping="Wrap" MaxHeight="200" TextTrimming="CharacterEllipsis" Margin="0,0,0,8"/>
                                            <Button Content="{DynamicResource WorkbenchEditNote}" Click="ResumeNoteClick" Style="{StaticResource DrawerAction}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DrawerCard}">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="DrawerCopyPathClick"
                                                        ToolTip="{DynamicResource L706EA53B0776}" AutomationProperties.Name="{DynamicResource L706EA53B0776}">
                                                    <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/>
                                                </Button>
                                                <TextBlock Text="{DynamicResource LCC8B7C8AADF0}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                            <TextBlock x:Name="DrawerEntryName" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,2"/>
                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                                            <TextBlock Text="{Binding Folder}" ToolTip="{Binding Folder}" TextWrapping="Wrap"
                                                       FontFamily="Consolas" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,5,0,0"/>
                                            <TextBlock x:Name="DrawerGitDetail" Text="{Binding Git.Detail}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource Muted}" Margin="0,7,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource DrawerCard}">
                                        <StackPanel>
                                            <TextBlock Text="Notlar ve belgeler" Style="{StaticResource DrawerHeading}"/>
                                            <TextBlock x:Name="DrawerPurposeText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,0,0,7"/>
                                            <WrapPanel>
                                                <Button Content="{DynamicResource LF8DC8F40534F}" Click="DrawerPurposeClick" Style="{StaticResource DrawerAction}"/>
                                                <Button Content="Belgeler" Click="DrawerDocumentsClick" Style="{StaticResource DrawerAction}"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="DrawerComponentsCard" Style="{StaticResource DrawerCard}" Visibility="Collapsed">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource L33905B08DDA3}" Style="{StaticResource DrawerHeading}"/>
                                            <ItemsControl x:Name="DrawerComponents">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,4,0,6">
                                                            <TextBlock Text="{Binding Component.Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,2,0,4"/>
                                                            <Button Content="{Binding Action}" Tag="{Binding Component}" Click="DrawerToggleComponentClick"
                                                                    Style="{StaticResource DrawerAction}" HorizontalAlignment="Left"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </dxdo:LayoutPanel>
                    <dxdo:LayoutPanel x:Name="GitPane" Caption="{DynamicResource LD11171088FD5}" MinWidth="295" Closed="True"/>
                </dxdo:TabbedGroup>
            </dxdo:LayoutGroup>
        </dxdo:DockLayoutManager>

        <Border Grid.Row="2">
            <DockPanel Margin="14,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Muted}" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LEB28C758D53B}" Foreground="{DynamicResource Muted}" FontSize="11"/>
                </StackPanel>
                <ProgressBar x:Name="BusyBar" DockPanel.Dock="Right" Width="76" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="6,0"/>
                <TextBlock x:Name="StatusText" Text="{DynamicResource LDE7108A5098A}" Foreground="{DynamicResource Muted}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
