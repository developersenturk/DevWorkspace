<UserControl x:Class="DevWorkspace.AppUpdateToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             Width="360" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
             Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
    </UserControl.Resources>
    <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="16">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <dx:SimpleButton DockPanel.Dock="Right" Command="{Binding Dismiss}" Content="×" Width="28" Height="28"
                                 Padding="0" FontSize="18" AutomationProperties.Name="{DynamicResource UpdateDismiss}"/>
                <TextBlock Text="DevWorkspace" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,12,0,0"
                         Visibility="{Binding Downloading, Converter={StaticResource VisibleWhenTrue}}"
                         AutomationProperties.Name="{DynamicResource UpdateProgress}"/>
            <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasAction, Converter={StaticResource VisibleWhenTrue}}">
                <dx:SimpleButton Content="{DynamicResource UpdateRestart}" Command="{Binding Restart}" Padding="12,6"
                                 Visibility="{Binding Ready, Converter={StaticResource VisibleWhenTrue}}"/>
                <dx:SimpleButton Content="{DynamicResource UpdateRetry}" Command="{Binding Retry}" Padding="12,6"
                                 Visibility="{Binding Failed, Converter={StaticResource VisibleWhenTrue}}"/>
                <dx:SimpleButton Content="{DynamicResource UpdateReleases}" Command="{Binding Install}" Padding="12,6"
                                 Visibility="{Binding Unavailable, Converter={StaticResource VisibleWhenTrue}}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
