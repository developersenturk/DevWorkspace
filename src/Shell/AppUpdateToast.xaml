<UserControl x:Class="DevWorkspace.AppUpdateToast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             Width="380" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
             Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue"/>
        <Style x:Key="ToastCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="{TemplateBinding Background}" CornerRadius="4">
                            <Path Data="M 0,0 L 8,8 M 8,0 L 0,8" Width="8" Height="8" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseSurface" Property="Background" Value="{DynamicResource PanelSoft}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CloseSurface" Property="BorderBrush" Value="{DynamicResource Ink}"/><Setter TargetName="CloseSurface" Property="BorderThickness" Value="1"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource Shell}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
            CornerRadius="8" Padding="16,12,16,16">
        <StackPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Command="{Binding Dismiss}" Style="{StaticResource ToastCloseButton}"
                        AutomationProperties.Name="{DynamicResource UpdateDismiss}"/>
                <TextBlock Text="DevWorkspace" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" LineHeight="20"
                       AutomationProperties.LiveSetting="Polite"/>
            <ProgressBar Value="{Binding Progress}" Maximum="100" Height="4" Margin="0,12,0,0"
                         Visibility="{Binding Downloading, Converter={StaticResource VisibleWhenTrue}}"
                         AutomationProperties.Name="{DynamicResource UpdateProgress}"/>
            <WrapPanel Margin="0,12,0,0" Visibility="{Binding HasAction, Converter={StaticResource VisibleWhenTrue}}">
                <dx:SimpleButton Content="{DynamicResource UpdateRestart}" Command="{Binding Restart}" Padding="12,6"
                                 Visibility="{Binding Ready, Converter={StaticResource VisibleWhenTrue}}"/>
                <dx:SimpleButton Content="{DynamicResource UpdateRetry}" Command="{Binding Retry}" Padding="12,6"
                                 Visibility="{Binding Failed, Converter={StaticResource VisibleWhenTrue}}"/>
                <dx:SimpleButton Content="{DynamicResource UpdateReleases}" Command="{Binding Install}" Padding="12,6"
                                 Visibility="{Binding Unavailable, Converter={StaticResource VisibleWhenTrue}}"/>
            </WrapPanel>
        </StackPanel>
    </Border>
</UserControl>
