<dx:ThemedWindow x:Class="DevWorkspace.ProjectPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 Width="650" Height="415" MinWidth="455" MinHeight="300"
                 Title="{DynamicResource LFBBDAF1D3B4D}" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" PreviewKeyDown="PickerKeyDown" Loaded="PickerLoaded">
    <dx:ThemedWindow.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></dx:ThemedWindow.Resources>
    <Grid Margin="13">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBox x:Name="QueryBox" Height="35" Padding="8,4" VerticalContentAlignment="Center" TextChanged="QueryChanged"
                 AutomationProperties.Name="{DynamicResource L48F595DDE343}" ToolTip="{DynamicResource L48F595DDE343}"/>
        <dxe:ListBoxEdit x:Name="Results" Grid.Row="1" Margin="0,9,0,8"
                 ItemContainerStyle="{StaticResource NavRow}" AutomationProperties.Name="{DynamicResource LF3FF5E8495C3}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <dxe:ListBoxEdit.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="0,2" Background="Transparent" PreviewMouseLeftButtonDown="ResultClick">
                        <Border DockPanel.Dock="Right" Style="{StaticResource StatusBadge}" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="{Binding Project.Git.Label}" Style="{StaticResource StatusLabel}"/>
                        </Border>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Project.DisplayPath}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </dxe:ListBoxEdit.ItemTemplate>
        </dxe:ListBoxEdit>
        <DockPanel Grid.Row="2">
            <Button x:Name="ChooseButton" DockPanel.Dock="Right" Content="{DynamicResource LDCC084F9A2E1}" Style="{StaticResource Primary}" Click="ChooseClick" Margin="9,0,0,0"/>
            <TextBlock x:Name="PickerHint" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</dx:ThemedWindow>

