<dx:ThemedWindow x:Class="DevWorkspace.ToolSetupWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Title="{DynamicResource LC6FBE8071474}" Width="700" Height="545" MinWidth="490" MinHeight="400"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Loaded="WindowLoaded" Closing="WindowClosing" Closed="WindowClosed">
    <dx:ThemedWindow.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></dx:ThemedWindow.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,13">
            <TextBlock Text="{DynamicResource LC6FBE8071474}" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock x:Name="SetupHint" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
        </StackPanel>
        <ListBox x:Name="ToolsList" Grid.Row="1" SelectionChanged="ToolChanged" HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="{DynamicResource L0396370AB0F7}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="5,4">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Definition.Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Definition.Use}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Margin="0,13,0,0">
            <TextBlock x:Name="SetupStatus" TextWrapping="Wrap" MinHeight="30" AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel HorizontalAlignment="Right">
                <Button x:Name="GuideButton" Content="{DynamicResource L005D2BDEB299}" Click="GuideClick" Margin="0,0,6,4"/>
                <Button x:Name="RecheckButton" Content="{DynamicResource LBC74ADD79F8B}" Click="RecheckClick" Margin="0,0,6,4"/>
                <Button x:Name="InstallButton" Content="{DynamicResource L5D5E14554304}" Click="InstallClick" Style="{StaticResource Primary}"
                        Background="{DynamicResource BadgeAccentSurface}" Foreground="{DynamicResource BadgeAccentText}" Margin="0,0,6,4"/>
                <Button x:Name="CloseButton" Content="{DynamicResource L7B31A9FC4816}" Click="CloseClick" Margin="0,0,0,4"/>
            </WrapPanel>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
