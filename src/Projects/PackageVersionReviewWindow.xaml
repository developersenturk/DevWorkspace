<dx:ThemedWindow x:Class="DevWorkspace.PackageVersionReviewWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Width="650" Height="430" MinWidth="450" MinHeight="330"
                 Title="Paket sürümü değişiklikleri" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True">
    <dx:ThemedWindow.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></dx:ThemedWindow.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock x:Name="ProjectLabel" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <TextBlock x:Name="ManifestLabel" Margin="0,4,0,7" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
            <TextBlock x:Name="ReviewExplanation"
                       Text="Onayladığınızda bu sürümler yazılır, kilit dosyaları güncellenir ve açıklar yeniden taranır."
                       TextWrapping="Wrap"/>
        </StackPanel>
        <ListBox x:Name="ChangesList" Grid.Row="1" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Önerilen paket sürümleri">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Padding="8,6" TextWrapping="Wrap"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,13,0,0">
            <Button Content="Atla" IsCancel="True" Padding="14,6"/>
            <Button Content="Onayla ve güncelle" Style="{StaticResource Primary}" Click="ApproveClick" Margin="8,0,0,0"/>
        </StackPanel>
    </Grid>
</dx:ThemedWindow>
