<dx:ThemedWindow x:Class="DevWorkspace.ComparisonWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 Title="{DynamicResource L05291A2B2B22}" Width="1110" Height="630"
                 MinWidth="735" MinHeight="420" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}" Loaded="WindowLoaded" Closed="WindowClosed">
    <dx:ThemedWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Resources/Workbench.xaml"/></ResourceDictionary.MergedDictionaries>
            <Style x:Key="RemovedDiff" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RowData.Row.Removed}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AddedDiff" TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding RowData.Row.Added}" Value="True">
                        <Setter Property="Background" Value="{DynamicResource BadgeSuccessSurface}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessText}"/>
                        <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </dx:ThemedWindow.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,8,0">
                <TextBlock x:Name="LeftName" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="LeftPathText" Style="{StaticResource SmallLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock x:Name="RightName" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock x:Name="RightPathText" Style="{StaticResource SmallLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="165"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Background="{DynamicResource Canvas}">
                <TextBox x:Name="FileQuery" DockPanel.Dock="Top" Height="30" Padding="6,4" TextChanged="FileQueryChanged"
                         ToolTip="{DynamicResource LCD9A48E05B22}" AutomationProperties.Name="{DynamicResource LCD9A48E05B22}"/>
                <dxe:ListBoxEdit x:Name="DifferenceList" SelectedIndexChanged="DifferenceChanged" ItemContainerStyle="{StaticResource NavRow}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{DynamicResource L49A1AC5285CA}">
                    <dxe:ListBoxEdit.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Path}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                <TextBlock Text="{Binding Label}" Style="{StaticResource SmallLabel}"/>
                            </StackPanel>
                        </DataTemplate>
                    </dxe:ListBoxEdit.ItemTemplate>
                </dxe:ListBoxEdit>
            </DockPanel>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" ShowsPreview="True" Background="{DynamicResource Line}"/>
            <DockPanel Grid.Column="2" Background="{DynamicResource Canvas}">
                <TextBlock x:Name="PreviewCaption" DockPanel.Dock="Top" Padding="9,7" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                <dxg:GridControl x:Name="LinesGrid" AutoGenerateColumns="None" FontFamily="Consolas" FontSize="12"
                                 AutomationProperties.Name="{DynamicResource L523457A22423}">
                    <dxg:GridControl.Columns>
                        <dxg:GridColumn FieldName="Left" Header="{DynamicResource L46D88C6CFFF0}" Width="350">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource RemovedDiff}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="40" Text="{Binding RowData.Row.LeftNumber}" TextAlignment="Right" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RowData.Row.Left}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RowData.Row.Left}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                        <dxg:GridColumn FieldName="Right" Header="{DynamicResource LBDFDAB7C601A}" Width="350">
                            <dxg:GridColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource AddedDiff}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Width="40" Text="{Binding RowData.Row.RightNumber}" TextAlignment="Right" Margin="0,0,8,0"
                                                       Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding RowData.Row.Right}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding RowData.Row.Right}"/>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </dxg:GridColumn.CellTemplate>
                        </dxg:GridColumn>
                    </dxg:GridControl.Columns>
                    <dxg:GridControl.View>
                        <dxg:TableView AutoWidth="True" AllowEditing="False" NavigationStyle="Row" ShowGroupPanel="False"
                                       ShowIndicator="False" AllowColumnFiltering="False" RowMinHeight="23" AllowSorting="False" AllowGrouping="False" AllowColumnMoving="False"/>
                    </dxg:GridControl.View>
                </dxg:GridControl>
            </DockPanel>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" IsCancel="True" Content="{DynamicResource L7B31A9FC4816}" Margin="8,0,0,0"/>
            <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Text="{DynamicResource L16B8AA0D1CDD}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</dx:ThemedWindow>

