<dx:ThemedWindow x:Class="DevWorkspace.VisualStudioPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Title="{DynamicResource VisualStudioChoose}" Width="680" Height="430" MinWidth="500" MinHeight="350"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{DynamicResource VisualStudioChoose}" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock x:Name="ProjectPath" TextTrimming="CharacterEllipsis" Margin="0,6,0,8"/>
            <TextBlock x:Name="Hint" Text="{DynamicResource VisualStudioRememberHint}" TextWrapping="Wrap"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button Content="{DynamicResource VisualStudioBrowse}" Click="BrowseClick" DockPanel.Dock="Left" Padding="10,6"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource CancelSettings}" IsCancel="True" MinWidth="80" Margin="8,0"/>
                <Button Content="{DynamicResource VisualStudioOpen}" Click="OpenClick" IsDefault="True" MinWidth="125"/>
            </StackPanel>
        </DockPanel>
        <ListBox x:Name="Installations" HorizontalContentAlignment="Stretch"
                 AutomationProperties.Name="{DynamicResource VisualStudioInstallations}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,7">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="11"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</dx:ThemedWindow>
