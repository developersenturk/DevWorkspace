<dx:ThemedWindow x:Class="DevWorkspace.ProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
        MinWidth="400" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Loaded="DetailLoaded" Closing="DetailClosing" Closed="DetailClosed" PreviewKeyDown="DetailKeyDown">
    <dx:ThemedWindow.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></dx:ThemedWindow.Resources>
    <dx:ThemedWindow.DialogButtons>
        <dx:ThemedWindowDialogButton x:Name="RemoveGroupButton" Content="Gruptan çıkar" Placement="Left"
                                     AllowCloseWindow="False" Click="RemoveGroupClick" Visibility="Collapsed"/>
        <dx:ThemedWindowDialogButton x:Name="CloseButton" Content="Kapat" IsCancel="True" DialogResult="Cancel" MinWidth="72"/>
        <dx:ThemedWindowDialogButton x:Name="PurposeCancelButton" Content="Vazgeç" AllowCloseWindow="False"
                                     Click="CancelPurposeClick" MinWidth="72" Visibility="Collapsed"/>
        <dx:ThemedWindowDialogButton x:Name="PurposeSaveButton" Content="Kaydet" AllowCloseWindow="False"
                                     Click="SavePurposeClick" MinWidth="72" Visibility="Collapsed"/>
        <dx:ThemedWindowDialogButton x:Name="OrganizationSaveButton" Content="Kaydet" IsDefault="True" AllowCloseWindow="False"
                                     Click="SaveOrganizationClick" MinWidth="72" Visibility="Collapsed"/>
    </dx:ThemedWindow.DialogButtons>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="ProjectTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="3,0,3,10"/>
            <Grid Grid.Row="1" ClipToBounds="True">
                <ScrollViewer x:Name="PurposeView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <DockPanel>
                            <Button x:Name="EditPurposeButton" DockPanel.Dock="Right" Content="Düzenle" Click="EditPurposeClick"
                                    Style="{StaticResource IconButton}"/>
                            <TextBlock Text="Proje amacı" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock x:Name="PurposeText" Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
                        <StackPanel x:Name="PurposeEditor" Visibility="Collapsed" Margin="0,5,0,0">
                            <TextBox x:Name="PurposeInput" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82" MaxHeight="145"
                                     MaxLength="1200" VerticalScrollBarVisibility="Auto" Padding="6"
                                     AutomationProperties.Name="Proje amacı"/>
                        </StackPanel>
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,13,0,0" Padding="0,8,0,0">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Click="CopyPathClick" Style="{StaticResource IconButton}"
                                            AutomationProperties.Name="Proje yolunu kopyala" ToolTip="Proje yolunu kopyala">
                                        <TextBlock Text="&#xE8C8;" Style="{StaticResource Icon}"/>
                                    </Button>
                                    <TextBlock Text="Proje konumu" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Folder}" Foreground="{DynamicResource Muted}" FontSize="11"
                                           FontFamily="Consolas" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Grid x:Name="OrganizationEditor" Visibility="Collapsed" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="BulkProjectRow" Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="BulkGroupProjects" Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Auto" Margin="0,0,0,9" AutomationProperties.Name="Seçilen projeler">
                        <ItemsControl x:Name="BulkGroupProjectList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding RelativePath}" ToolTip="{Binding RelativePath}" TextTrimming="CharacterEllipsis"
                                                   FontSize="11" Foreground="{DynamicResource Muted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel Grid.Row="1">
                        <TextBlock Text="Proje grubu" Style="{StaticResource SmallLabel}"/>
                        <ComboBox x:Name="ProjectGroupBox" IsEditable="True" Height="28" Margin="0,4,0,7" AutomationProperties.Name="Proje grubu"/>
                        <TextBlock x:Name="ProjectLabelTitle" Text="Sürüm etiketi" Style="{StaticResource SmallLabel}"/>
                        <ComboBox x:Name="ProjectLabelBox" Height="28" Margin="0,4,0,7" AutomationProperties.Name="Sürüm etiketi"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="DocumentsView" Background="{DynamicResource Canvas}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{DynamicResource Shell}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,1" Padding="9,5">
                        <DockPanel>
                            <Button x:Name="OpenDocumentButton" DockPanel.Dock="Right" Content="Dosyayı aç" Click="OpenDocumentClick"
                                    IsEnabled="False" Margin="8,0,0,0"/>
                            <ComboBox x:Name="DocumentPicker" DisplayMemberPath="Label" MinHeight="30" VerticalContentAlignment="Center"
                                      SelectionChanged="DocumentChanged" AutomationProperties.Name="Proje belgesi"/>
                        </DockPanel>
                    </Border>
                    <FlowDocumentScrollViewer x:Name="DocumentReader" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              IsToolBarVisible="False" Visibility="Collapsed" AutomationProperties.Name="Belge önizlemesi"/>
                    <TextBlock x:Name="DocumentMessage" Grid.Row="1" Text="Belgeler aranıyor…"
                               Foreground="{DynamicResource Muted}" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="320"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12"/>
                </Grid>
            </Grid>
        <TextBlock x:Name="DetailMessage" Grid.Row="2" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="3,0"/>
    </Grid>
</dx:ThemedWindow>
