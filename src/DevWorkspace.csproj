<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>DevWorkspace.Program</StartupObject>
    <Version>1.3.5</Version>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>Assets/DevWorkspace.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="../LICENSE" Link="LICENSE" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
    <EmbeddedResource Include="Localization/*.json" />
    <EmbeddedResource Include="Updates/ReleaseNotes.*.md" WithCulture="false" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <Resource Include="Assets/DevWorkspace.ico" />
    <PackageReference Include="DevExpress.Wpf.Docking" Version="26.1.4" />
    <PackageReference Include="DevExpress.Wpf.Grid.Core" Version="26.1.4" />
    <PackageReference Include="DevExpress.Wpf.ThemesLW" Version="26.1.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
  </ItemGroup>
  <Target Name="RemoveWinFormsImplicitUsings" BeforeTargets="GenerateGlobalUsings">
    <ItemGroup>
      <Using Remove="System.Windows.Forms;System.Drawing" />
    </ItemGroup>
  </Target>

</Project>
