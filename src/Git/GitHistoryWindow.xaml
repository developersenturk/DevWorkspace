<Window x:Class="DevWorkspace.GitHistoryWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
        Title="Git geçmişi" Width="880" Height="530" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Loaded="HistoryLoaded" Closed="HistoryClosed">
    <Window.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,0,10">
            <TextBlock x:Name="HistoryTitle" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="RepositoryPath" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
            <dxg:GridControl x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="None" AutomationProperties.Name="Git commit geçmişi">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="COMMIT" FieldName="Hash" Width="92"/>
                    <dxg:GridColumn Header="TARİH" FieldName="Date" Width="108"/>
                    <dxg:GridColumn Header="YAZAR" FieldName="Author" Width="145"/>
                    <dxg:GridColumn Header="MESAJ" FieldName="Subject" Width="*" MinWidth="135"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True" AllowEditing="False" NavigationStyle="Row" ShowGroupPanel="False"
                                   ShowIndicator="False" ShowVerticalLines="False" AllowColumnFiltering="False" RowMinHeight="29"/>
                </dxg:GridControl.View>
            </dxg:GridControl>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Kapat" IsCancel="True" Margin="8,0,0,0"/>
            <TextBlock x:Name="HistoryStatus" Text="Git geçmişi okunuyor…" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>
