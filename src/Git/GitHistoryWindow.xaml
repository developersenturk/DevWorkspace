<dx:ThemedWindow x:Class="DevWorkspace.GitHistoryWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid"
                 Title="{DynamicResource L8C9C5A963356}" Width="880" Height="530" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterOwner"
                 ShowInTaskbar="False" Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}"
                 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Loaded="HistoryLoaded" Closed="HistoryClosed">
    <dx:ThemedWindow.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></dx:ThemedWindow.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="3,0,0,10">
            <TextBlock x:Name="HistoryTitle" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="RepositoryPath" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
            <dxg:GridControl x:Name="HistoryGrid" Grid.Row="1" AutoGenerateColumns="None" AutomationProperties.Name="{DynamicResource L13CB0059FD53}">
                <dxg:GridControl.Columns>
                    <dxg:GridColumn Header="COMMIT" FieldName="Hash" Width="92"/>
                    <dxg:GridColumn Header="{DynamicResource LF47943753384}" FieldName="Date" Width="108"/>
                    <dxg:GridColumn Header="{DynamicResource LC2C05FBA24B2}" FieldName="Author" Width="145"/>
                    <dxg:GridColumn Header="{DynamicResource L270D52363DD8}" FieldName="Subject" Width="490" MinWidth="135"/>
                </dxg:GridControl.Columns>
                <dxg:GridControl.View>
                    <dxg:TableView AutoWidth="True" AllowEditing="False" NavigationStyle="Row" ShowGroupPanel="False"
                                   ShowIndicator="False" ShowVerticalLines="False" AllowColumnFiltering="False" RowMinHeight="29"/>
                </dxg:GridControl.View>
            </dxg:GridControl>
        <DockPanel Grid.Row="2" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="{DynamicResource L7B31A9FC4816}" IsCancel="True" Margin="8,0,0,0"/>
            <TextBlock x:Name="HistoryStatus" Text="{DynamicResource LE233711F15C1}" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</dx:ThemedWindow>
