<UserControl x:Class="DevWorkspace.GitDiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxg="http://schemas.devexpress.com/winfx/2008/xaml/grid" PreviewKeyDown="DiffKeyDown">
    <UserControl.Resources>
        <DataTemplate x:Key="DiffLine">
            <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0" MinHeight="21">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Canvas}"/>
                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Ink}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Tone}" Value="Added">
                                <Setter Property="Background" Value="{DynamicResource BadgeSuccessSurface}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Removed">
                                <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Missing">
                                <Setter Property="Background" Value="{DynamicResource MissingDiffLines}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Tone}" Value="Gap">
                                <Setter Property="Background" Value="{DynamicResource NeutralSurface}"/>
                                <Setter Property="TextElement.Foreground" Value="{DynamicResource Muted}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid TextElement.FontFamily="Consolas" TextElement.FontSize="12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Number}" Foreground="{DynamicResource Muted}" TextAlignment="Right" Margin="3,2,8,2"/>
                    <TextBlock Grid.Column="1" Text="{Binding Marker}" FontWeight="SemiBold" TextAlignment="Center" Margin="0,2"/>
                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" Margin="3,2,7,2"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Background="{DynamicResource Canvas}">
        <WrapPanel DockPanel.Dock="Top" Background="{DynamicResource PanelSoft}" Margin="0,0,0,5">
            <Button x:Name="PreviousChangeButton" Content="{DynamicResource PreviousChange}" Click="PreviousChangeClick"
                    ToolTip="{DynamicResource PreviousChangeHint}" IsEnabled="False" Padding="8,5" Margin="4"/>
            <TextBlock x:Name="ChangePositionText" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="8,4"/>
            <Button x:Name="NextChangeButton" Content="{DynamicResource NextChange}" Click="NextChangeClick"
                    ToolTip="{DynamicResource NextChangeHint}" IsEnabled="False" Padding="8,5" Margin="4"/>
        </WrapPanel>
        <TextBlock x:Name="Notice" DockPanel.Dock="Top" Foreground="{DynamicResource Muted}" Background="{DynamicResource PanelSoft}"
                   TextWrapping="Wrap" Padding="9,5" Visibility="Collapsed"/>
        <dxg:GridControl x:Name="DiffGrid" Background="{DynamicResource Canvas}" DataAreaBackground="{DynamicResource Canvas}" BorderThickness="0"
                         AutoGenerateColumns="None" AutomationProperties.Name="{DynamicResource LCDD952539B50}">
            <dxg:GridControl.Columns>
                <dxg:GridColumn x:Name="BeforeColumn" FieldName="BeforeText" Header="{DynamicResource LC9809CB12580}" Width="*">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate><ContentControl Content="{Binding RowData.Row.BeforeCell}" ContentTemplate="{StaticResource DiffLine}"/></DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
                <dxg:GridColumn x:Name="AfterColumn" FieldName="AfterText" Header="{DynamicResource L765EB2F15309}" Width="*">
                    <dxg:GridColumn.CellTemplate>
                        <DataTemplate><ContentControl Content="{Binding RowData.Row.AfterCell}" ContentTemplate="{StaticResource DiffLine}"/></DataTemplate>
                    </dxg:GridColumn.CellTemplate>
                </dxg:GridColumn>
            </dxg:GridControl.Columns>
            <dxg:GridControl.View>
                <dxg:TableView x:Name="DiffTable" AutoWidth="True" AllowEditing="False" AllowSorting="False"
                               AllowColumnMoving="False" AllowColumnFiltering="False" NavigationStyle="Cell"
                               ShowGroupPanel="False" ShowIndicator="False" ShowHorizontalLines="False"
                               ShowVerticalLines="False" ShowFocusedRectangle="True">
                    <dxg:TableView.ColumnHeaderStyle>
                        <Style TargetType="dxg:GridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </dxg:TableView.ColumnHeaderStyle>
                </dxg:TableView>
            </dxg:GridControl.View>
        </dxg:GridControl>
    </DockPanel>
</UserControl>
