<dx:ThemedWindow x:Class="DevWorkspace.GitHubPublishWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Title="{DynamicResource LB8B4F417A9FF}" Width="520" SizeToContent="Height" ResizeMode="NoResize"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Loaded="WindowLoaded" Closing="WindowClosing">
    <StackPanel Margin="20">
        <TextBlock x:Name="BranchDescription" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <Label Content="{DynamicResource L1060A43F0F06}" Target="{Binding ElementName=RepositoryOwner}" Padding="0,0,0,4"/>
        <ComboBox x:Name="RepositoryOwner" DisplayMemberPath="Label" SelectionChanged="OwnerChanged"
                  AutomationProperties.Name="{DynamicResource L983E370272B7}"/>
        <Label Content="{DynamicResource LE4D063B65C9E}" Target="{Binding ElementName=RepositoryName}" Padding="0,10,0,4"/>
        <TextBox x:Name="RepositoryName" MaxLength="100" TextChanged="NameChanged" AutomationProperties.Name="{DynamicResource LF4CECD1EDDA6}"/>
        <TextBlock x:Name="RepositoryTarget" Margin="0,5,0,0" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
        <CheckBox x:Name="PrivateRepository" Content="{DynamicResource LA8E364446AFA}" IsChecked="True" Margin="0,10,0,0"/>
        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
            <TextBlock x:Name="Status" TextWrapping="Wrap"/>
        </ScrollViewer>
        <StackPanel x:Name="DevicePanel" Orientation="Horizontal" Visibility="Collapsed" Margin="0,8,0,0">
            <TextBox x:Name="DeviceCode" IsReadOnly="True" Width="125" AutomationProperties.Name="{DynamicResource L80C417723593}"/>
            <Button Content="{DynamicResource L0920621B1669}" Margin="6,0,0,0" Click="OpenDevicePageClick"/>
        </StackPanel>
        <WrapPanel HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="InstallButton" Content="{DynamicResource L773AB66B96E7}" Click="InstallClick" Visibility="Collapsed" Margin="6,4,0,0"/>
            <Button x:Name="LoginButton" Content="{DynamicResource L6E01F85E977F}" Click="LoginClick" Visibility="Collapsed" Margin="6,4,0,0"/>
            <Button x:Name="WorkflowPermissionButton" Content="{DynamicResource L210FD4EB4F92}" Click="WorkflowPermissionClick" Visibility="Collapsed" Margin="6,4,0,0"/>
            <Button x:Name="RetryButton" Content="{DynamicResource L0CE9380B07F8}" Click="RetryClick" Visibility="Collapsed" Margin="6,4,0,0"/>
            <Button x:Name="Publish" Content="{DynamicResource L88C147DB2E07}" Click="PublishClick" IsEnabled="False" MinWidth="130" Margin="6,4,0,0"/>
            <Button x:Name="OpenRepository" Content="{DynamicResource LA15AA049890B}" Click="OpenRepositoryClick" Visibility="Collapsed" Margin="6,4,0,0"/>
            <Button x:Name="CloseButton" Content="{DynamicResource L7B31A9FC4816}" Click="CloseClick" MinWidth="70" Margin="6,4,0,0"/>
        </WrapPanel>
    </StackPanel>
</dx:ThemedWindow>
