<dx:ThemedWindow x:Class="DevWorkspace.GitRemotesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors" xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Title="{DynamicResource LD6C4F95B9979}" Width="580" SizeToContent="Height" ResizeMode="NoResize"
                 ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock x:Name="ProjectHeading" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource L1ABC642FDFF5}" Margin="0,4,0,10" Foreground="{DynamicResource Muted}"/>
        <dxe:ListBoxEdit x:Name="RemoteList" MaxHeight="280" SelectedIndexChanged="RemoteSelectionChanged"
                 AutomationProperties.Name="Uzak depolar" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <dxe:ListBoxEdit.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Url, TargetNullValue={StaticResource AddressUnreadable}}"
                                   TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </DataTemplate>
            </dxe:ListBoxEdit.ItemTemplate>
        </dxe:ListBoxEdit>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button x:Name="RemoveButton" Content="{DynamicResource L587DEF6E04D2}" Click="RemoveClick" IsEnabled="False" Padding="8,4"/>
            <Button Content="{DynamicResource L7B31A9FC4816}" IsCancel="True" Margin="7,0,0,0" Padding="8,4"/>
        </StackPanel>
    </StackPanel>
</dx:ThemedWindow>
