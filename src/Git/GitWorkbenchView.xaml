<UserControl x:Class="DevWorkspace.GitWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors">
    <UserControl.Resources>
        <DataTemplate x:Key="FileRow">
            <Grid Margin="2,2" Background="Transparent" ToolTip="{Binding DisplayPath}"
                  PreviewMouseRightButtonDown="FileRightClick" PreviewMouseLeftButtonUp="FileLeftClick">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="1" CornerRadius="4" Padding="5,2" Margin="6,0,0,0" VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BadgeNeutralSurface}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusCode}" Value="A">
                                    <Setter Property="Background" Value="{DynamicResource BadgeSuccessSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusCode}" Value="M">
                                    <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusCode}" Value="D">
                                    <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Label}" FontSize="10" TextTrimming="CharacterEllipsis" MaxWidth="126"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="12,9">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="RepositoryTitle" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="RepositoryPath" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="BranchStatus" Text="Depo okunuyor…" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,7,0,8"/>
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Uzak depo" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <dxe:ComboBoxEdit x:Name="FetchRemote" DisplayMember="Name" IsTextEditable="False"
                                  EditValueChanged="FetchRemoteChanged" AutomationProperties.Name="Fetch için uzak depo"/>
            </DockPanel>
            <TextBlock x:Name="FetchUrl" Margin="0,4,0,7" TextTrimming="CharacterEllipsis" FontSize="11"
                       Foreground="{DynamicResource Muted}"/>
            <UniformGrid Columns="3">
                <dx:SimpleButton x:Name="FetchButton" Content="Fetch" Click="FetchClick" IsEnabled="False" Margin="0,0,4,0"/>
                <dx:SimpleButton x:Name="PullButton" Content="Pull" Click="PullClick" IsEnabled="False" Margin="2,0"
                                 ToolTipService.ShowOnDisabled="True"/>
                <dx:SimpleButton x:Name="PushButton" Content="Push" Click="PushClick" IsEnabled="False" Margin="4,0,0,0"
                                 ToolTipService.ShowOnDisabled="True"/>
            </UniformGrid>
            <dxe:ComboBoxEdit x:Name="PushRemote" Margin="0,6,0,0" Visibility="Collapsed" DisplayMember="Label"
                              IsTextEditable="False" NullText="İlk push için hedef seçin" EditValueChanged="PushRemoteChanged"
                              AutomationProperties.Name="İlk push için hedef depo"/>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <dx:SimpleButton x:Name="RefreshButton" Content="Yenile" Click="RefreshClick" Margin="0,0,6,0"/>
                <dx:SimpleButton x:Name="HistoryButton" Content="Git geçmişi" Click="HistoryClick"/>
            </StackPanel>
            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,10,0,8"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,9,0,0">
            <dxe:TextEdit x:Name="CommitMessage" Height="52" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                          MaxLength="4096" NullText="Commit mesajı" EditValueChanged="CommitMessageChanged"
                          AutomationProperties.Name="Commit mesajı"/>
            <dx:SimpleButton x:Name="CommitButton" Content="Hazırlananları commit et" Click="CommitClick" IsEnabled="False" Margin="0,5,0,0"/>
            <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" MaxHeight="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}" FontSize="11"/>
        </StackPanel>
        <Grid x:Name="ChangeControls">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition x:Name="WorkingRow" Height="*"/><RowDefinition Height="Auto"/>
                <RowDefinition x:Name="StagedRow" Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,4">
                <dx:SimpleButton x:Name="StageAllButton" DockPanel.Dock="Right" Content="Tümünü hazırla"
                                 Click="StageAllClick" IsEnabled="False" Margin="6,0,0,0" ToolTipService.ShowOnDisabled="True"/>
                <TextBlock x:Name="WorkingTitle" Text="Değişiklikler" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <dxe:ListBoxEdit x:Name="WorkingFiles" Grid.Row="1" ItemTemplate="{StaticResource FileRow}" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended"
                             EditValueChanged="FileSelectionChanged" PreviewKeyDown="FileMenuKey" AutomationProperties.Name="Değişiklikler"/>
            <TextBlock x:Name="StagedTitle" Grid.Row="2" Text="Hazırlananlar" FontWeight="SemiBold" Margin="0,7,0,4"/>
            <dxe:ListBoxEdit x:Name="StagedFiles" Grid.Row="3" ItemTemplate="{StaticResource FileRow}" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedIndexChanged="FileSelectionChanged" PreviewKeyDown="FileMenuKey" AutomationProperties.Name="Hazırlanan dosyalar"/>
            <UniformGrid Grid.Row="4" Columns="2" Margin="0,6,0,0">
                <dx:SimpleButton x:Name="DiffButton" Content="Farkı aç" Click="DiffClick" IsEnabled="False" Margin="0,0,3,0"/>
                <dx:SimpleButton x:Name="FileAction" Content="Hazırla" Click="FileActionClick" IsEnabled="False" Margin="3,0,0,0"/>
            </UniformGrid>
        </Grid>
    </DockPanel>
</UserControl>
