<UserControl x:Class="DevWorkspace.GitWorkbenchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dxe="http://schemas.devexpress.com/winfx/2008/xaml/editors"
             xmlns:local="clr-namespace:DevWorkspace"
             Background="{DynamicResource PanelSoft}" Foreground="{DynamicResource Ink}">
    <UserControl.Resources>
        <Style x:Key="GitToolButton" TargetType="Button">
            <Setter Property="Width" Value="27"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource BadgeAccentSurface}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GitSectionHeader" TargetType="ToggleButton">
            <Setter Property="MinHeight" Value="29"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="Arrow" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="5,0,7,0"
                                           VerticalAlignment="Center" Foreground="{DynamicResource Ink}"/>
                                <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Text" Value="&#xE70D;"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GitFileContainer" TargetType="dxe:ListBoxEditItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <DataTemplate x:Key="FileRow">
            <Grid Margin="5,1" MinHeight="21" Background="Transparent" ToolTip="{Binding DisplayPath}"
                  AutomationProperties.HelpText="{Binding Label}"
                  PreviewMouseRightButtonDown="FileRightClick" PreviewMouseLeftButtonUp="FileLeftClick">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                <TextBlock Grid.Column="1" Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Border Grid.Column="2" CornerRadius="4" Padding="4,1" MinWidth="18" Margin="6,0,0,0" VerticalAlignment="Center"
                        ToolTip="{Binding Label}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource BadgeNeutralSurface}"/>
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeNeutralText}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusCode}" Value="A">
                                    <Setter Property="Background" Value="{DynamicResource BadgeSuccessSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeSuccessText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusCode}" Value="M">
                                    <Setter Property="Background" Value="{DynamicResource BadgeWarningSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeWarningText}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusCode}" Value="D">
                                    <Setter Property="Background" Value="{DynamicResource BadgeErrorSurface}"/>
                                    <Setter Property="TextElement.Foreground" Value="{DynamicResource BadgeErrorText}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusCode}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <DockPanel Margin="10,8">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="RepositoryTitle" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
            <DockPanel Margin="0,6,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="4,0,0,0">
                    <Button x:Name="FetchButton" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE896;}"
                            Click="FetchClick" IsEnabled="False" ToolTip="{DynamicResource L5434B2AD0F2B}" AutomationProperties.Name="Fetch"/>
                    <Button x:Name="PullButton" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE74B;}"
                            Click="PullClick" IsEnabled="False" ToolTip="Pull" AutomationProperties.Name="Pull"/>
                    <Button x:Name="PushButton" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE74A;}"
                            Click="PushClick" IsEnabled="False" ToolTip="Push" AutomationProperties.Name="Push"/>
                    <Button x:Name="RefreshButton" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE72C;}"
                            Click="RefreshClick" ToolTip="{DynamicResource L63CD725787A8}" AutomationProperties.Name="{DynamicResource L63CD725787A8}"/>
                    <Button x:Name="MoreButton" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE712;}"
                            Click="OpenActionMenu" ToolTip="{DynamicResource L788512902684}" AutomationProperties.Name="{DynamicResource L788512902684}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AddRemoteItem" Header="{DynamicResource L72BD54B2A9F8}" Click="AddRemoteClick"/>
                                <MenuItem x:Name="ManageRemotesItem" Header="{DynamicResource L104E13DAB317}" Click="ManageRemotesClick"/>
                                <MenuItem x:Name="PublishMenuItem" Header="{DynamicResource L57F889172928}" Click="PublishClick"/>
                                <MenuItem x:Name="PushSelectedItem" Header="{DynamicResource L254AEF848DE2}"
                                          Visibility="Collapsed"/>
                                <Separator/>
                                <MenuItem x:Name="HistoryButton" Header="{DynamicResource L8C9C5A963356}" Click="HistoryClick" Icon="{local:MenuGlyph &#xE81C;}"/>
                                <MenuItem Header="{DynamicResource L89245D66A841}" Click="ReferencesClick"/>
                                <MenuItem x:Name="DiffButton" Header="{DynamicResource L725FC78D5E65}" Click="DiffClick" IsEnabled="False"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
                <Button x:Name="BranchButton" Click="OpenActionMenu" Padding="7,3" HorizontalContentAlignment="Stretch"
                        ToolTip="{DynamicResource L068F507BBF94}" AutomationProperties.Name="{DynamicResource LA108D8CC38D6}">
                    <Button.ContextMenu>
                        <ContextMenu Opened="BranchMenuOpened" MaxHeight="420"/>
                    </Button.ContextMenu>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BranchName" Text="{DynamicResource LB5D3117F5311}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                </Button>
            </DockPanel>
            <TextBlock x:Name="BranchStatus" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="2,4,0,7"/>
            <DockPanel x:Name="FetchRemoteRow" Margin="0,0,0,6" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Left" Text="{DynamicResource LC473DD3B059A}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <dxe:ComboBoxEdit x:Name="FetchRemote" DisplayMember="Name" IsTextEditable="False"
                                  EditValueChanged="FetchRemoteChanged" AutomationProperties.Name="{DynamicResource L0D833351BC2A}"/>
            </DockPanel>
            <dxe:TextEdit x:Name="CommitMessage" Height="66" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                          MaxLength="4096" NullText="{DynamicResource L8EE1EA014085}" ShowNullTextForEmptyValue="True" EditValueChanged="CommitMessageChanged"
                          AutomationProperties.Name="{DynamicResource L11C0B60765A4}"/>
            <WrapPanel Margin="0,5,0,0">
                <Button x:Name="CommitButton" Content="{DynamicResource L45A779D7FD19}" Click="CommitClick" IsEnabled="False" Padding="8,3"/>
                <Button x:Name="CommitMenuButton" Content="{local:MenuGlyph &#xE70D;}" Click="OpenActionMenu" Width="28" Margin="1,0,5,0"
                        ToolTip="{DynamicResource L77A6ADB62666}" AutomationProperties.Name="{DynamicResource L77A6ADB62666}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="CommitMenuItem" Header="{DynamicResource L45A779D7FD19}" Click="CommitClick"/>
                            <MenuItem x:Name="CommitPushMenuItem" Header="{DynamicResource L8418000C8F8E}" Click="CommitPushClick"/>
                            <MenuItem x:Name="AmendMenuItem" Header="{DynamicResource AmendAction}" Click="AmendClick" IsEnabled="False"/>
                            <Separator/>
                            <MenuItem x:Name="SaveStashMenuItem" Header="{DynamicResource L54221F592243}" Click="SaveStashClick"
                                      IsEnabled="False" ToolTipService.ShowOnDisabled="True"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="AmendButton" Content="{DynamicResource AmendAction}" Click="AmendClick" IsEnabled="False" Padding="8,3" Margin="0,0,5,0"
                        ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="PublishButton" Content="{DynamicResource L57F889172928}" Click="PublishClick" Padding="8,3"
                        IsEnabled="False" Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"/>
            </WrapPanel>
            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,9,0,4"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,3,0,0">
            <Button DockPanel.Dock="Right" Content="{local:MenuGlyph &#xE711;}" Height="24" Width="24" Margin="5,0,0,0"
                    Click="DismissStatusClick" ToolTip="{DynamicResource L8AC0CAA9E704}" AutomationProperties.Name="{DynamicResource L87ED7F9DED95}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GitToolButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=StatusMessage}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <TextBlock x:Name="StatusMessage" Margin="0,6,0,0" MaxHeight="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="{DynamicResource Muted}" FontSize="11"/>
        </DockPanel>
        <Grid x:Name="ChangeControls">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition x:Name="StagedRow" Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition x:Name="WorkingRow" Height="*"/>
                <RowDefinition Height="Auto"/><RowDefinition x:Name="StashRow" Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <Button x:Name="UnstageButton" DockPanel.Dock="Right" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE738;}"
                        Click="FileActionClick" IsEnabled="False" ToolTip="{DynamicResource LA9899DD9E891}" AutomationProperties.Name="{DynamicResource LA9899DD9E891}"/>
                <ToggleButton x:Name="StagedSection" Style="{StaticResource GitSectionHeader}" IsChecked="True" Click="ToggleSectionClick">
                    <TextBlock x:Name="StagedTitle" Text="{DynamicResource L6305F6C5B5B8}" Foreground="{DynamicResource Ink}"/>
                </ToggleButton>
            </DockPanel>
            <TextBlock x:Name="StagedEmpty" Grid.Row="1" Text="{DynamicResource L4B3F644B1D83}" Margin="23,3,0,7"
                       Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
            <dxe:ListBoxEdit x:Name="StagedFiles" Grid.Row="1" ItemTemplate="{StaticResource FileRow}" Visibility="Collapsed"
                             ItemContainerStyle="{StaticResource GitFileContainer}" ShowBorder="False" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectedIndexChanged="FileSelectionChanged" PreviewKeyDown="FileMenuKey" AutomationProperties.Name="{DynamicResource LFC177AB33AFF}"/>
            <DockPanel Grid.Row="2" Margin="0,4,0,0">
                <Button x:Name="StageAllButton" DockPanel.Dock="Right" Style="{StaticResource GitToolButton}"
                        Click="StageAllClick" IsEnabled="False" ToolTip="{DynamicResource L4DAE76448375}" AutomationProperties.Name="{DynamicResource L4DAE76448375}">
                    <Path Width="16" Height="14" Stroke="{DynamicResource Ink}" StrokeThickness="1.3"
                          Data="M 2,8 L 10,8 M 6,4 L 6,12 M 10,4 L 16,4 M 13,1 L 13,7"/>
                </Button>
                <Button x:Name="FileAction" DockPanel.Dock="Right" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE710;}"
                        Click="FileActionClick" IsEnabled="False" ToolTip="{DynamicResource L0F72090B9A51}" AutomationProperties.Name="{DynamicResource L0F72090B9A51}"/>
                <ToggleButton x:Name="WorkingSection" Style="{StaticResource GitSectionHeader}" IsChecked="True" Click="ToggleSectionClick">
                    <TextBlock x:Name="WorkingTitle" Text="{DynamicResource L015C1B0968C6}" Foreground="{DynamicResource Ink}"/>
                </ToggleButton>
            </DockPanel>
            <TextBlock x:Name="WorkingEmpty" Grid.Row="3" Text="{DynamicResource L68215615BBA1}" Margin="23,3,0,7"
                       Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
            <dxe:ListBoxEdit x:Name="WorkingFiles" Grid.Row="3" ItemTemplate="{StaticResource FileRow}" Visibility="Collapsed"
                             ItemContainerStyle="{StaticResource GitFileContainer}" ShowBorder="False" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Extended"
                             EditValueChanged="FileSelectionChanged" PreviewKeyDown="FileMenuKey" AutomationProperties.Name="{DynamicResource L015C1B0968C6}"/>
            <DockPanel Grid.Row="4" Margin="0,4,0,0">
                <Button x:Name="SaveStashButton" DockPanel.Dock="Right" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE710;}"
                        Click="SaveStashClick" IsEnabled="False" AutomationProperties.Name="{DynamicResource L54221F592243}"/>
                <Button x:Name="ApplyStashButton" DockPanel.Dock="Right" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE7A7;}"
                        Click="ApplyStashClick" IsEnabled="False" ToolTip="{DynamicResource LA9C3AB9AF911}" AutomationProperties.Name="{DynamicResource LA9C3AB9AF911}"/>
                <Button x:Name="DropStashButton" DockPanel.Dock="Right" Style="{StaticResource GitToolButton}" Content="{local:MenuGlyph &#xE74D;}"
                        Click="DropStashClick" IsEnabled="False" ToolTip="{DynamicResource LC72AE7130464}" AutomationProperties.Name="{DynamicResource LC72AE7130464}"/>
                <ToggleButton x:Name="StashSection" Style="{StaticResource GitSectionHeader}" IsChecked="False" Click="ToggleSectionClick">
                    <TextBlock x:Name="StashTitle" Text="{DynamicResource L7BF92BD00BEB}" Foreground="{DynamicResource Ink}"/>
                </ToggleButton>
            </DockPanel>
            <TextBlock x:Name="StashEmpty" Grid.Row="5" Text="{DynamicResource L781AF62B5E01}" Margin="23,3,0,7"
                       Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
            <dxe:ListBoxEdit x:Name="StashList" Grid.Row="5" ItemContainerStyle="{StaticResource GitFileContainer}"
                             ShowBorder="False" Background="Transparent" Visibility="Collapsed"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectedIndexChanged="StashSelectionChanged"
                             AutomationProperties.Name="{DynamicResource L7BF92BD00BEB}">
                <dxe:ListBoxEdit.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}" ToolTip="{Binding Detail}" TextTrimming="CharacterEllipsis"
                                   MinHeight="21" Margin="6,2" VerticalAlignment="Center"/>
                    </DataTemplate>
                </dxe:ListBoxEdit.ItemTemplate>
            </dxe:ListBoxEdit>
        </Grid>
    </DockPanel>
</UserControl>
