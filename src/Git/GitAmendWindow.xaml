<dx:ThemedWindow x:Class="DevWorkspace.GitAmendWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 Title="{DynamicResource AmendTitle}" Width="610" MinWidth="470" SizeToContent="Height"
                 ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource AmendTitle}" FontSize="21" FontWeight="SemiBold"/>
        <TextBlock x:Name="CommitInfo" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,14"/>
        <TextBlock x:Name="StagedInfo" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <Label Content="{DynamicResource AmendMessage}" Target="{Binding ElementName=MessageInput}" Padding="0,0,0,5"/>
        <TextBox x:Name="MessageInput" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 MinHeight="160" MaxHeight="280" TextChanged="MessageChanged" AutomationProperties.Name="{DynamicResource AmendMessage}"/>
        <TextBlock Text="{DynamicResource AmendHint}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,12,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{DynamicResource CancelSettings}" IsCancel="True" MinWidth="80" Margin="0,0,8,0"/>
            <Button x:Name="ApplyButton" Content="{DynamicResource AmendApply}" Click="ApplyClick" IsDefault="True" MinWidth="130"/>
        </StackPanel>
    </StackPanel>
</dx:ThemedWindow>
