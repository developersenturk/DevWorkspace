<dx:ThemedWindow x:Class="DevWorkspace.GitReferencesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core"
                 xmlns:local="clr-namespace:DevWorkspace"
                 Width="1040" Height="680" MinWidth="720" MinHeight="420" ShowInTaskbar="False"
                 WindowStartupLocation="CenterOwner" Loaded="WindowLoaded" Closing="WindowClosing">
    <DockPanel Margin="12">
        <TextBlock x:Name="Status" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <StackPanel x:Name="RefControls" DockPanel.Dock="Top" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Dala geç" Click="SwitchClick" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Dal / etiket" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="Reference" DisplayMemberPath="Label" AutomationProperties.Name="Dal veya etiket"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,10">
                <Button DockPanel.Dock="Right" Content="Etiket oluştur" Click="CreateTagClick" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="Dal oluştur" Click="CreateBranchClick" Margin="6,0,0,0"/>
                <TextBlock DockPanel.Dock="Left" Text="Yeni ad" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="NewName" MaxLength="240" AutomationProperties.Name="Yeni dal veya etiket adı"
                         ToolTip="Seçili dal veya etiketi başlangıç olarak kullanır."/>
            </DockPanel>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Before" DisplayMemberPath="Label" Margin="0,0,6,0" AutomationProperties.Name="Önceki dal veya etiket"/>
                <ComboBox x:Name="After" Grid.Column="1" DisplayMemberPath="Label" Margin="0,0,6,0" AutomationProperties.Name="Sonraki dal veya etiket"/>
                <Button Grid.Column="2" Content="Karşılaştır" Click="CompareClick"/>
            </Grid>
            <ComboBox x:Name="Files" SelectionChanged="FileChanged" AutomationProperties.Name="Farkı gösterilecek dosya"/>
        </StackPanel>
        <local:GitDiffView x:Name="Preview"/>
    </DockPanel>
</dx:ThemedWindow>
