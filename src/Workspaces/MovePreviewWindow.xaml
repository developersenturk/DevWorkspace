<Window x:Class="DevWorkspace.MovePreviewWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Taşıma planı" Width="950" Height="550"
        MinWidth="660" MinHeight="385" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" Background="{DynamicResource WorkspaceBackground}" Foreground="{DynamicResource Ink}" Closed="WindowClosed">
    <Window.Resources><ResourceDictionary Source="../Resources/Workbench.xaml"/></Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="ProjectTitle" FontSize="19" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourcePath" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Muted}"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Margin="0,3,0,9"/>
        </StackPanel>
        <DockPanel Grid.Row="1">
            <Button x:Name="AnalyzeButton" DockPanel.Dock="Right" Content="Önizle" Style="{StaticResource Primary}" Click="AnalyzeClick" Margin="6,0,0,0"/>
            <Button x:Name="BrowseTargetButton" DockPanel.Dock="Right" Content="Göz at…" Click="BrowseClick" Margin="6,0,0,0"/>
            <TextBlock DockPanel.Dock="Left" Text="Hedef üst klasör" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TargetFolder" Height="31" VerticalContentAlignment="Center" Padding="6,3"
                     TextChanged="TargetChanged" AutomationProperties.Name="Hedef üst klasör"/>
        </DockPanel>
        <TextBlock x:Name="DestinationText" Grid.Row="2" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,8,0,7"/>
        <DataGrid x:Name="FindingsGrid" Grid.Row="3" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" RowHeight="31" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource Divider}" AutomationProperties.Name="Taşıma bulguları">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DURUM" Binding="{Binding Severity}" Width="135" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="DOSYA" Binding="{Binding File}" Width="1.4*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="BAŞVURU" Binding="{Binding Reference}" Width="1*" ElementStyle="{StaticResource CellText}"/>
                <DataGridTextColumn Header="AYRINTI" Binding="{Binding Detail}" Width="1.5*" ElementStyle="{StaticResource CellText}"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow"><Setter Property="ToolTip" Value="{Binding Detail}"/></Style>
            </DataGrid.RowStyle>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" IsCancel="True" Content="Kapat" Margin="8,0,0,0"/>
            <TextBlock x:Name="PlanStatus" Text="Hedefi seçerek başvuruları ve çakışmaları kontrol edin." VerticalAlignment="Center"
                       Foreground="{DynamicResource Muted}" TextWrapping="Wrap"/>
        </DockPanel>
    </Grid>
</Window>

